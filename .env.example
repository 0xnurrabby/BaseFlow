# Server-only CDP Paymaster URL. Do not expose this directly to the browser.
CDP_PAYMASTER_URL="https://api.developer.coinbase.com/rpc/v1/base/YOUR_PAYMASTER_ID"

# Server-side allowlist guard used by pages/api/paymaster.ts.
# Set this after deploying contracts/BaseFlowMultisender.sol.
MULTISENDER_CONTRACT_ADDRESS="0x136cc543E5ae13DFdc27c651E9357066cC7365cf"

# Public contract address used by the frontend hook.
NEXT_PUBLIC_MULTISENDER_CONTRACT_ADDRESS="0x136cc543E5ae13DFdc27c651E9357066cC7365cf"

# Base mainnet = 8453, Base Sepolia = 84532.
NEXT_PUBLIC_BASEFLOW_CHAIN_ID="8453"

# Relative URLs are converted to absolute browser URLs by the hook.
NEXT_PUBLIC_PAYMASTER_PROXY_URL="/api/paymaster"

# Optional browser origin lock for the proxy, for example https://baseflow.vercel.app.
PAYMASTER_ALLOWED_ORIGIN=""

# Optional app branding for Base Account SDK.
NEXT_PUBLIC_BASEFLOW_APP_LOGO_URL=""
